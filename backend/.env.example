# -----------------------------------------------------------------------
# Database Mode — set to True to use Azure, False to use DATABASE_URL
# -----------------------------------------------------------------------
USE_AZURE_DB=False

# -----------------------------------------------------------------------
# Option A: Azure Database for PostgreSQL – Flexible Server
# (active when USE_AZURE_DB=True)
# -----------------------------------------------------------------------
AZURE_POSTGRES_HOST=your-server.postgres.database.azure.com
AZURE_POSTGRES_PORT=5432
AZURE_POSTGRES_DB=aarogyadesk
AZURE_POSTGRES_USER=your_admin_user
AZURE_POSTGRES_PASSWORD=your_strong_password
AZURE_POSTGRES_SSL_MODE=require

# -----------------------------------------------------------------------
# Option B: Direct connection URL
# (active when USE_AZURE_DB=False)
# -----------------------------------------------------------------------
DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# JWT
SECRET_KEY=change-this-to-a-strong-secret-key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# App
DEBUG=False

# Redis Cache
CACHE_ENABLED=true
REDIS_URL=redis://localhost:6379/0
CACHE_DEFAULT_TTL_SECONDS=300
